{
  "name": "alfacode",
  "version": "0.1.0",
  "private": true,
  "description": "Run Claude Code against configurable AI providers through an isolated local gateway.",
  "type": "module",
  "bin": {
    "alfacode": "./dist/cli.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:claude": "tsx scripts/smoke-claude.ts",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@google/genai": "^1.30.0",
    "commander": "^14.0.2",
    "fastify": "^5.6.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  },
  "license": "MIT"
}
