{
  "name": "alfacode",
  "version": "0.1.0",
  "private": true,
  "description": "A polished multi-provider AI coding agent for the terminal, powered by a pinned Claude Code engine.",
  "type": "module",
  "bin": {
    "alfacode": "./dist/cli.js"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.30.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alfanowski/AlfaCode.git"
  },
  "homepage": "https://github.com/alfanowski/AlfaCode#readme",
  "bugs": {
    "url": "https://github.com/alfanowski/AlfaCode/issues"
  },
  "author": "Andrea Alfano",
  "keywords": [
    "ai-coding-agent",
    "claude-code",
    "gemini",
    "google-ai-studio",
    "llm",
    "multi-provider",
    "opencode-zen",
    "terminal",
    "tool-use",
    "tui"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:claude": "tsx scripts/smoke-claude.ts",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@google/genai": "^1.30.0",
    "@napi-rs/keyring": "1.3.0",
    "commander": "^14.0.2",
    "fastify": "^5.6.2",
    "string-width": "8.2.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  },
  "license": "MIT"
}
