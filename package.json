{
  "name": "alfacode",
  "version": "0.1.0",
  "private": true,
  "description": "A native multi-provider coding-agent TUI powered by a pinned Claude Code engine.",
  "type": "module",
  "bin": {
    "alfacode": "./dist/cli.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:claude": "tsx scripts/smoke-claude.ts",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.241",
    "@google/genai": "^1.30.0",
    "@napi-rs/keyring": "1.3.0",
    "commander": "^14.0.2",
    "fastify": "^5.6.2",
    "ink": "7.1.1",
    "marked": "18.0.10",
    "react": "19.2.8",
    "string-width": "8.2.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "19.2.14",
    "ink-testing-library": "4.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  },
  "license": "MIT"
}
